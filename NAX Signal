          state.bx = c.x; state.by = c.y;
        }
        saveState();
      } else if (opts.onTap) {
        opts.onTap();
      }
      if (opts.onMoveEnd) opts.onMoveEnd();
    }

    handle.addEventListener("pointerdown", onDown);
    handle.addEventListener("pointermove", onMove, { passive: true });
    handle.addEventListener("pointerup", onUp);
    handle.addEventListener("pointercancel", onUp);
  }

  /* ══════════════════════════════════════════════════════════
     WINDOW CONTROLS
     ══════════════════════════════════════════════════════════ */
  function rotateBubbleArrow(deg) { if (els.bubArrow) els.bubArrow.style.transform = "rotate(" + deg + "deg)"; }
  function resetBubbleArrow() { if (els.bubArrow) els.bubArrow.style.transform = "rotate(0deg)"; }

  function openWindow() {
    var win = els.win;
    win.style.display = "block";
    applySizeClass();
    requestAnimationFrame(function () {
      placeWindow();
      win.classList.add("show");
    });
    els.bubble.classList.remove("show");
    startEngine();
    startAutoHide();
    updateEngineStatus(lastStatus);
    maybeShowFirstTip();
  }

  function closeWindow() {
    stopEngine();
    clearTimeout(autoHideTimer); autoHideTimer = null;
    els.win.classList.remove("show");
    els.bubble.classList.remove("show");
    window.setTimeout(function () { els.win.style.display = "none"; }, state.animation ? 200 : 0);
  }

  function minimizeWindow() {
    els.win.classList.remove("show");
    clearTimeout(autoHideTimer); autoHideTimer = null;
    window.setTimeout(function () {
      els.win.style.display = "none";
      els.bubble.classList.add("show");
      placeBubble();
      resetBubbleArrow();
    }, state.animation ? 180 : 0);
    saveState();
  }

  function restoreWindow() {
    els.bubble.classList.remove("show");
    resetBubbleArrow();
    openWindow();
  }

  function toggleLock() {
    state.locked = !state.locked;
    updateLockUI();
    updateSegUI();
    saveState();
    toast(state.locked ? "🔒 POSITION LOCKED" : "🔓 POSITION UNLOCKED",
          state.locked ? "ok" : "info", 1600);
  }

  function updateLockUI() {
    var locked = !!state.locked;
    var svg = locked ? ICONS.LOCK : ICONS.UNLOCK;
    els.btnLock.innerHTML = svg;
    els.btnLock.classList.toggle("on", locked);
    els.btnLock.setAttribute("aria-label", locked ? "Unlock position" : "Lock position");
    els.btnLock.title = locked ? "Unlock position" : "Lock position";
    var lbl = els.btnLockF.querySelector(".lbl");
    var footerSvgHost = els.btnLockF.querySelector("svg");
    if (footerSvgHost) {
      var tmp = document.createElement("div");
      tmp.innerHTML = svg;
      els.btnLockF.replaceChild(tmp.firstChild, footerSvgHost);
    }
    els.btnLockF.classList.toggle("on", locked);
    if (lbl) lbl.textContent = locked ? "LOCKED" : "LOCK";
  }

  /* ══════════════════════════════════════════════════════════
     SIZE / OPACITY / SOUND / MODE
     ══════════════════════════════════════════════════════════ */
  var lastSize = "";
  function applySizeClass() {
    if (lastSize === state.size) return;
    els.win.classList.remove("size-small", "size-medium", "size-large");
    els.win.classList.add("size-" + state.size);
    lastSize = state.size;
  }

  function setWindowSize(size) {
    if (["small", "medium", "large"].indexOf(size) === -1) return;
    state.size = size;
    lastSize = "";
    applySizeClass();
    requestAnimationFrame(function () { placeWindow(); });
    updateSegUI();
    saveState();
  }

  function setOpacity(v) {
    v = Number(v); if (isNaN(v)) return;
    state.opacity = clamp(v, 30, 100);
    els.win.style.opacity = state.opacity / 100;
    updateSegUI();
    saveState();
  }

  function updateSoundUI() {
    var host = document.getElementById("soundIcon");
    if (host) {
      var wrap = document.createElement("div");
      wrap.innerHTML = state.sound ? ICONS.SOUND_ON : ICONS.SOUND_OFF;
      host.parentNode.replaceChild(wrap.firstChild, host);
    }
    els.soundIcon = document.getElementById("soundIcon");
    safeText(els.soundLabel, "SOUND: " + (state.sound ? "ON" : "OFF"));
    els.btnSound.classList.toggle("on", !!state.sound);
  }

  function toggleSound() {
    state.sound = !state.sound;
    updateSoundUI();
    updateSegUI();
    saveState();
    toast(state.sound ? "🔊 SOUND ON" : "🔇 SOUND OFF", state.sound ? "ok" : "info", 1400);
  }

  function updateModeUI() {
    for (var i = 0; i < els.stBtns.length; i++) {
      var m = Number(els.stBtns[i].dataset.mode);
      var on = m === Number(state.mode);
      els.stBtns[i].classList.toggle("active", on);
      els.stBtns[i].setAttribute("aria-pressed", on ? "true" : "false");
    }
  }

  function setMode(m) {
    m = clamp(Number(m) || 1, 1, 4);
    if (state.mode === m) return;
    state.mode = m;
    updateModeUI();
    saveState();
  }

  function updateSegUI() {
    for (var i = 0; i < els.segs.length; i++) {
      var seg = els.segs[i];
      var key = seg.dataset.key;
      var cur = state[key];
      if (typeof cur === "boolean") cur = String(cur);
      var btns = seg.children;
      for (var j = 0; j < btns.length; j++) {
        var match = String(btns[j].dataset.val) === String(cur);
        btns[j].classList.toggle("active", match);
        btns[j].setAttribute("aria-pressed", match ? "true" : "false");
      }
    }
  }

  /* ══════════════════════════════════════════════════════════
     AUTO HIDE
     ══════════════════════════════════════════════════════════ */
  var autoHideTimer = null;
  function startAutoHide() {
    clearTimeout(autoHideTimer); autoHideTimer = null;
    if (!state.autoHide || state.autoHide <= 0) return;
    if (els.win.style.display === "none") return;
    autoHideTimer = window.setTimeout(minimizeWindow, state.autoHide * 1000);
  }

  /* ══════════════════════════════════════════════════════════
     MODALS
     ══════════════════════════════════════════════════════════ */
  var lastFocused = null;
  function openModal(modal) {
    lastFocused = document.activeElement;
    modal.classList.add("show");
    var btn = modal.querySelector(".mbtn, .seg button, .reset-btn, .modal-x");
    if (btn) window.setTimeout(function () { btn.focus(); }, 50);
  }
  function closeModal(modal) {
    modal.classList.remove("show");
    if (lastFocused && lastFocused.focus) {
      try { lastFocused.focus(); } catch (e) {}
    }
  }

  function resetLayout() {
    state = Object.assign({}, DEFAULT_STATE);
    try { localStorage.removeItem(CONFIG.LS_UI); } catch (e) {}
    lastSize = "";
    els.win.style.opacity = "1";
    els.win.classList.remove("no-anim");
    updateLockUI();
    updateSoundUI();
    updateModeUI();
    updateSegUI();
    placeWindow("tr");
    placeBubble();
    clearTimeout(autoHideTimer);
    startAutoHide();
    saveState();
    toast("↺ LAYOUT RESET", "ok", 1600);
  }

  /* ══════════════════════════════════════════════════════════
     ENGINE STATUS
     ══════════════════════════════════════════════════════════ */
  var STATUS = {
    ONLINE:     { color: "#00ff88", label: "ONLINE",     cls: "" },
    CONNECTING: { color: "#ffcc00", label: "CONNECTING", cls: "warn" },
    ERROR:      { color: "#ff003c", label: "ERROR",      cls: "err" },
    OFFLINE:    { color: "#8a8a95", label: "OFFLINE",    cls: "err" }
  };
  var lastStatus = "CONNECTING";
  var lastStatusKey = "";

  function updateEngineStatus(status) {
    var key = (status in STATUS) ? status : "OFFLINE";
    lastStatus = key;
    if (lastStatusKey === key) return;
    lastStatusKey = key;
    var s = STATUS[key];
    if (els.statusDot) {
      els.statusDot.className = "sdot " + s.cls;
      els.statusDot.style.background = s.color;
      els.statusDot.style.boxShadow = "0 0 .35em " + s.color;
    }
    safeText(els.statusText, s.label);
    if (els.statusText) els.statusText.style.color = s.color;
  }

  /* ══════════════════════════════════════════════════════════
     MARKET ENGINE
     ══════════════════════════════════════════════════════════ */
  var currentId = "";
  var martingaleStep = 1;
  var lastSignal = "";
  var tickTimer = null;
  var fetching = false;
  var fetchRetries = 0;

  function playWinSfx() {
    if (!state.sound || !els.sfx) return;
    try { els.sfx.currentTime = 0; var p = els.sfx.play(); if (p && p.catch) p.catch(function () {}); } catch (e) {}
  }

  function voiceAnnounce(txt) {
    if (!state.sound) return;
    if (!("speechSynthesis" in window)) return;
    try {
      window.speechSynthesis.cancel();
      var msg = new SpeechSynthesisUtterance(txt);
      msg.rate = 1.4;
      window.speechSynthesis.speak(msg);
    } catch (e) {}
  }

  function vibrate(p) {
    if (!state.vibration) return;
    if (navigator.vibrate) { try { navigator.vibrate(p); } catch (e) {} }
  }

  function getStreaks(arr) {
    var out = [];
    if (!arr.length) return out;
    var cur = { type: arr[0], count: 1 };
    for (var i = 1; i < arr.length; i++) {
      if (arr[i] === cur.type) cur.count++;
      else { out.push(cur); cur = { type: arr[i], count: 1 }; }
    }
    out.push(cur);
    return out;
  }

  function addLogRow(issueId, pred, pattern) {
    var empty = els.logs.querySelector(".logs-empty");
    if (empty) empty.remove();
    var row = document.createElement("div");
    row.className = "log-row";
    var idEl = document.createElement("span");
    idEl.className = "log-id"; idEl.textContent = "#" + String(issueId).slice(-3);
    var resEl = document.createElement("span");
    resEl.className = "log-res " + pred; resEl.textContent = pred;
    var tagEl = document.createElement("span");
    tagEl.className = "log-tag"; tagEl.textContent = pattern;
    row.appendChild(idEl); row.appendChild(resEl); row.appendChild(tagEl);
    els.logs.insertBefore(row, els.logs.firstChild);
    while (els.logs.children.length > 5) els.logs.removeChild(els.logs.lastChild);
  }

  var lastAccShown = -1, lastWinShown = -1, lastLossShown = -1;
  function updateDashboard() {
    if (lastWinShown !== stats.wins) { safeText(els.winCount, stats.wins); lastWinShown = stats.wins; }
    if (lastLossShown !== stats.losses) { safeText(els.lossCount, stats.losses); lastLossShown = stats.losses; }
    var total = stats.wins + stats.losses;
    var rate = total === 0 ? 0 : Math.round((stats.wins / total) * 100);
    if (lastAccShown !== rate) { safeText(els.accRate, rate + "%"); lastAccShown = rate; }
  }

  function processMarket() {
    if (fetching) return;
    fetching = true;
    updateEngineStatus("CONNECTING");

    fetch(CONFIG.DATA_API + "?timestamp=" + Date.now(), { cache: "no-store" })
      .then(function (res) {
        if (!res.ok) throw new Error("HTTP " + res.status);
        return res.json();
      })
      .then(function (json) {
        fetchRetries = 0;
        var list = json && json.data && json.data.list;
        if (!list || !list.length) throw new Error("empty list");
        var latestId = String(list[0].issueNumber);
        if (latestId !== currentId) {
          if (currentId !== "" && lastSignal !== "") {
            var actual = parseInt(list[0].number, 10) >= 5 ? "BIG" : "SMALL";
            if (actual === lastSignal) {
              stats.wins++; martingaleStep = 1;
              playWinSfx(); vibrate(30);
            } else {
              stats.losses++;
              martingaleStep = martingaleStep < 4 ? martingaleStep + 1 : 1;
              vibrate([15, 35, 15]);
            }
            saveStats();
            updateDashboard();
            setMode(martingaleStep);
          }
          currentId = latestId;
          window.setTimeout(function () {
            var history = list.slice(0, 100).map(function (it) {
              return parseInt(it.number, 10) >= 5 ? "BIG" : "SMALL";
            });
            var streaks = getStreaks(history);
            var s1 = streaks[0] || { type: "BIG", count: 1 };
            var s2 = streaks[1] || { type: "SMALL", count: 1 };
            var s3 = streaks[2] || { type: "BIG", count: 1 };
            var pred = "BIG", dna = "ULTRA ANALYSIS", confidence = 90;

            if (s2.count === 4 && s1.count === 2 && s1.type !== s2.type) { pred = s2.type; dna = "4/2 CYCLE DNA"; confidence = 99; }
            else if (s2.count === 3 && s1.count === 2 && s1.type !== s2.type) { pred = s2.type; dna = "3/2 CYCLE DNA"; confidence = 98; }
            else if (s2.count === 3 && s1.count === 1 && s1.type !== s2.type) { pred = s1.type; dna = "3/1 CYCLE DNA"; confidence = 98; }
            else if (s2.count === 2 && s1.count === 1 && s1.type !== s2.type) { pred = s2.type; dna = "2/1 CYCLE DNA"; confidence = 97; }
            else if (s2.count === s1.count && s1.count >= 2 && s1.type !== s2.type) {
              pred = s1.type === "BIG" ? "SMALL" : "BIG";
              dna = s1.count + "/" + s1.count + " BLOCK DNA"; confidence = 96;
            }
            else if (s1.count >= 5) { pred = s1.type; dna = "DRAGON TREND"; confidence = 95; }
            else if (s1.count === 1 && s2.count === 1 && s3.count === 1) { pred = s1.type === "BIG" ? "SMALL" : "BIG"; dna = "ZIG-ZAG DNA"; confidence = 94; }
            else if (s1.count === 1 && s2.count >= 4) { pred = s1.type; dna = "TREND SHIFT"; confidence = 97; }
            else {
              var sample = history.slice(0, 15);
              var bigs = sample.filter(function (x) { return x === "BIG"; }).length;
              pred = bigs >= 8 ? "BIG" : "SMALL";
              dna = "ADAPTIVE SCAN"; confidence = 89;
            }

            if (martingaleStep > 2 && confidence < 95) confidence += 2;
            lastSignal = pred;
            els.prediction.textContent = pred;
            els.prediction.className = "sig-val " + pred;
            safeText(els.dnaInfo, dna);
            safeText(els.secureText, "SECURE: " + confidence + "%");
            addLogRow(latestId, pred, dna.split(" ")[0]);
            voiceAnnounce(pred);
            updateEngineStatus("ONLINE");
            fetching = false;
          }, 650);
        } else {
          updateEngineStatus("ONLINE");
          fetching = false;
        }
      })
      .catch(function (err) {
        if (window.console && console.warn) console.warn("[NAX] sync:", err.message);
        fetching = false;
        /* Retry with backoff */
        if (fetchRetries < CONFIG.MAX_RETRIES) {
          fetchRetries++;
          window.setTimeout(processMarket, 1200 * fetchRetries);
        } else {
          updateEngineStatus(navigator.onLine ? "ERROR" : "OFFLINE");
        }
      });
  }

  var lastRemaining = -1, lastSec = -1;
  function tick() {
    var sec = new Date().getSeconds();
    var remaining = CONFIG.CYCLE - (sec % CONFIG.CYCLE);
    if (remaining !== lastRemaining) {
      lastRemaining = remaining;
      safeText(els.timer, (remaining < 10 ? "0" : "") + remaining + "s");
      if (els.ringFg) els.ringFg.style.strokeDashoffset =
        (2 * Math.PI * 25) * (1 - remaining / CONFIG.CYCLE);
    }
    if (sec !== lastSec) {
      lastSec = sec;
      if (sec % CONFIG.CYCLE === 1) processMarket();
    }
  }

  function startEngine() {
    if (tickTimer) return;
    tick();
    tickTimer = window.setInterval(tick, 1000);
    processMarket();
  }
  function stopEngine() { if (tickTimer) { clearInterval(tickTimer); tickTimer = null; } }

  /* ══════════════════════════════════════════════════════════
     SHARE
     ══════════════════════════════════════════════════════════ */
  function doShare() {
    var pred = els.prediction ? els.prediction.textContent : "---";
    var dna  = els.dnaInfo ? els.dnaInfo.textContent : "";
    var text = "🔥 NAX PRO ENGINE V12.5\n" +
               "Signal: " + pred + "\n" +
               (dna ? dna + "\n" : "") +
               "Creator: NAX NAZMUL PRO\n" +
               CONFIG.TG_URL;
    var title = "NAX PRO — " + pred;

    if (navigator.share) {
      navigator.share({ title: title, text: text, url: CONFIG.TG_URL })
        .catch(function () { /* user cancelled — ignore */ });
      return;
    }
    /* Fallback: copy to clipboard */
    copyText(text, "📋 COPIED TO CLIPBOARD");
  }

  function copyText(txt, okMsg) {
    var done = function () { if (okMsg) toast(okMsg, "ok", 1600); };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(txt).then(done).catch(function () { legacyCopy(txt, done); });
    } else {
      legacyCopy(txt, done);
    }
  }

  function legacyCopy(txt, cb) {
    try {
      var ta = document.createElement("textarea");
      ta.value = txt;
      ta.style.position = "fixed"; ta.style.left = "-9999px";
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      document.body.removeChild(ta);
      if (cb) cb();
    } catch (e) { toast("COPY FAILED", "err", 1600); }
  }

  /* ══════════════════════════════════════════════════════════
     FIRST-VISIT TIP
     ══════════════════════════════════════════════════════════ */
  function maybeShowFirstTip() {
    try {
      if (localStorage.getItem(CONFIG.LS_TIP)) return;
    } catch (e) {}
    if (!els.firstTip) return;
    window.setTimeout(function () {
      els.firstTip.classList.add("show");
    }, 900);
  }
  function closeFirstTip() {
    if (els.firstTip) els.firstTip.classList.remove("show");
    try { localStorage.setItem(CONFIG.LS_TIP, "1"); } catch (e) {}
  }

  /* ══════════════════════════════════════════════════════════
     EVENT WIRING
     ══════════════════════════════════════════════════════════ */
  function wireEvents() {
    /* Header */
    els.btnLock.addEventListener("click", toggleLock);
    els.btnMin.addEventListener("click", minimizeWindow);
    els.btnClose.addEventListener("click", function () { openModal(els.closeModal); });

    /* Footer */
    els.btnLockF.addEventListener("click", toggleLock);
    els.btnHideF.addEventListener("click", minimizeWindow);
    els.btnSettings.addEventListener("click", function () { updateSegUI(); openModal(els.setModal); });
    els.btnTgF.addEventListener("click", function () {
      /* Force-open Telegram in new tab */
      try {
        var a = document.createElement("a");
        a.href = CONFIG.TG_URL; a.target = "_blank"; a.rel = "noopener noreferrer";
        a.style.position = "fixed"; a.style.left = "-9999px";
        document.body.appendChild(a); a.click();
        window.setTimeout(function () { if (a.parentNode) a.parentNode.removeChild(a); }, 800);
      } catch (e) { window.open(CONFIG.TG_URL, "_blank", "noopener,noreferrer"); }
    });

    /* Actions */
    els.btnSound.addEventListener("click", toggleSound);
    els.btnShare.addEventListener("click", doShare);

    /* ST buttons */
    els.stRow.addEventListener("click", function (e) {
      var b = e.target.closest(".st-btn");
      if (!b) return;
      setMode(b.dataset.mode);
      vibrate(10);
    });

    /* Signal tap → copy */
    if (els.sigTap) {
      els.sigTap.addEventListener("click", function () {
        var pred = els.prediction ? els.prediction.textContent : "";
        if (!pred || pred === "---") { toast("NO SIGNAL YET", "err", 1400); return; }
        var dna = els.dnaInfo ? els.dnaInfo.textContent : "";
        copyText(pred + (dna ? " · " + dna : ""), "📋 SIGNAL COPIED");
        vibrate(10);
      });
    }

    /* Stats tap → reset */
    var statsResetConfirm = 0;
    function tapStat() {
      var now = Date.now();
      if (now - statsResetConfirm < 2200) {
        stats.wins = 0; stats.losses = 0;
        saveStats(); updateDashboard();
        toast("📊 STATS RESET", "ok", 1500);
        statsResetConfirm = 0;
        vibrate(20);
      } else {
        statsResetConfirm = now;
        toast("TAP AGAIN TO RESET STATS", "info", 2000);
      }
    }
    if (els.statW) els.statW.addEventListener("click", tapStat);
    if (els.statL) els.statL.addEventListener("click", tapStat);

    /* Close modal */
    document.getElementById("cancelClose").addEventListener("click", function () {
      closeModal(els.closeModal);
    });
    document.getElementById("confirmClose").addEventListener("click", function () {
      closeModal(els.closeModal); closeWindow();
    });
    document.getElementById("closeSettings").addEventListener("click", function () {
      closeModal(els.setModal);
    });
    document.getElementById("btnReset").addEventListener("click", function () {
      resetLayout(); closeModal(els.setModal);
    });

    /* First tip close */
    var tipBtn = document.getElementById("tipClose");
    if (tipBtn) tipBtn.addEventListener("click", closeFirstTip);

    /* Segmented controls */
    for (var i = 0; i < els.segs.length; i++) {
      (function (seg) {
        seg.addEventListener("click", function (e) {
          var btn = e.target.closest("button[data-val]");
          if (!btn) return;
          var key = seg.dataset.key;
          var raw = btn.dataset.val;
          var val = raw;
          if (key === "opacity" || key === "autoHide") val = Number(raw);
          else if (key === "animation" || key === "sound" || key === "vibration" || key === "locked") val = (raw === "true");

          if (key === "size") setWindowSize(val);
          else if (key === "opacity") setOpacity(val);
          else if (key === "position") { state.position = val; placeWindow(val); saveState(); updateSegUI(); }
          else if (key === "autoHide") { state.autoHide = val; startAutoHide(); saveState(); updateSegUI(); }
          else if (key === "animation") { state.animation = val; els.win.classList.toggle("no-anim", !val); saveState(); updateSegUI(); }
          else if (key === "sound") { state.sound = val; updateSoundUI(); saveState(); updateSegUI(); }
          else if (key === "vibration") { state.vibration = val; saveState(); updateSegUI(); }
          else if (key === "locked") { state.locked = val; updateLockUI(); saveState(); updateSegUI(); }
          vibrate(8);
        });
      })(els.segs[i]);
    }

    /* Modal backdrop */
    [els.closeModal, els.setModal].forEach(function (back) {
      back.addEventListener("click", function (e) { if (e.target === back) closeModal(back); });
    });

    /* ESC key */
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") {
        if (els.closeModal.classList.contains("show")) closeModal(els.closeModal);
        else if (els.setModal.classList.contains("show")) closeModal(els.setModal);
        else if (els.firstTip && els.firstTip.classList.contains("show")) closeFirstTip();
      }
    });

    /* Auto-hide reset */
    els.win.addEventListener("pointerdown", startAutoHide, { passive: true });

    /* Bubble — tap to restore + drag with rotating arrow */
    makeDraggable(els.bubble, els.bubble, {
      onTap: restoreWindow,
      onDirection: rotateBubbleArrow,
      onMoveEnd: resetBubbleArrow
    });
    els.bubble.addEventListener("keydown", function (e) {
      if (e.key === "Enter" || e.key === " ") { e.preventDefault(); restoreWindow(); }
    });

    /* Window drag */
    makeDraggable(els.win, els.dragHandle, { isLocked: function () { return state.locked; } });

    /* Resize / orientation */
    var rzTimer = null;
    function onResize() {
      clearTimeout(rzTimer);
      rzTimer = window.setTimeout(function () {
        if (els.win.style.display !== "none") {
          var c = clampWin(state.x || 0, state.y || 0);
          state.x = c.x; state.y = c.y;
          setPos(els.win, c.x, c.y);
        }
        if (els.bubble.classList.contains("show")) placeBubble();
        saveState();
      }, 120);
    }
    window.addEventListener("resize", onResize);
    window.addEventListener("orientationchange", function () { window.setTimeout(onResize, 240); });

    /* Network events */
    window.addEventListener("offline", function () {
      updateEngineStatus("OFFLINE");
      showNet("⚠ OFFLINE — CHECK CONNECTION", "err");
    });
    window.addEventListener("online", function () {
      updateEngineStatus("CONNECTING");
      showNet("✓ BACK ONLINE", "ok");
      processMarket();
    });

    /* Visibility */
    document.addEventListener("visibilitychange", function () {
      if (document.hidden) { clearTimeout(autoHideTimer); autoHideTimer = null; }
      else { startAutoHide(); }
    });

    /* Prevent pull-to-refresh on mobile */
    document.addEventListener("touchmove", function (e) {
      if (e.touches && e.touches.length === 1) {
        var t = e.target;
        /* only block if not inside a scrollable area */
        if (t && t.closest && !t.closest(".logs, .win-inner, .modal")) {
          if (e.cancelable) e.preventDefault();
        }
      }
    }, { passive: false });
  }

  /* ══════════════════════════════════════════════════════════
     BOOT
     ══════════════════════════════════════════════════════════ */
  function boot() {
    cacheDom();
    restoreState();
    restoreStats();

    els.win.classList.toggle("no-anim", !state.animation);
    els.win.style.opacity = state.opacity / 100;

    updateLockUI();
    updateSoundUI();
    updateModeUI();
    updateSegUI();
    updateDashboard();

    if (els.ringFg) {
      els.ringFg.style.strokeDasharray = 2 * Math.PI * 25;
      els.ringFg.style.strokeDashoffset = 0;
    }

    wireEvents();

    els.lockScreen.style.display = "none";
    openWindow();

    /* Anti-tamper Telegram URLs */
    [document.getElementById("btnTelegram"),
     document.getElementById("creatorBadge"),
     document.getElementById("manualTg")].forEach(function (a) {
      if (!a) return;
      var h = a.getAttribute("href") || "";
      if (!isSecureURL(h) || h.indexOf("NAX7XTNazmul") === -1) {
        a.setAttribute("href", CONFIG.TG_URL);
      }
    });

    toast("🚀 ENGINE V" + CONFIG.VERSION + " READY", "ok", 1800);
  }

  /* ══════════════════════════════════════════════════════════
     🔐 ACCESS GATE — WRONG PASSWORD → TELEGRAM
     ══════════════════════════════════════════════════════════ */
  var redirecting = false;

  function openTelegram() {
    if (redirecting) return;
    redirecting = true;

    var input = document.getElementById("accessKey");
    var btn   = document.getElementById("btnUnlock");

    /* Visual feedback */
    if (input) {
      input.value = "";
      input.classList.remove("err");
      void input.offsetWidth;
      input.classList.add("err");
      input.blur();
    }
    if (els.lockHint) {
      els.lockHint.className = "lock-hint show err";
      els.lockHint.textContent = "✕ WRONG KEY — OPENING TELEGRAM…";
    }
    if (els.lockCard) els.lockCard.classList.add("redirecting");
    if (btn) {
      btn.classList.add("redirecting");
      btn.textContent = "OPENING TELEGRAM…";
      btn.disabled = true;
    }
    try { if (navigator.vibrate) navigator.vibrate([40, 30, 40]); } catch (e) {}

    /* Show manual fallback after a beat */
    window.setTimeout(function () {
      if (els.manualTg) els.manualTg.classList.add("show");
    }, 900);

    /* Real anchor click — the most reliable redirect method */
    function clickAnchor(target) {
      try {
        var a = document.createElement("a");
        a.href = CONFIG.TG_URL;
        a.rel = "noopener noreferrer";
        if (target) a.target = target;
        a.style.position = "fixed";
        a.style.left = "-9999px";
        a.style.top = "-9999px";
        document.body.appendChild(a);
        a.click();
        window.setTimeout(function () {
          if (a.parentNode) a.parentNode.removeChild(a);
        }, 1200);
        return true;
      } catch (e) { return false; }
    }

    /* Immediate same-tab navigation */
    var ok = clickAnchor("_self");
    if (!ok) {
      try { window.location.href = CONFIG.TG_URL; }
      catch (e1) {
        try { window.location.assign(CONFIG.TG_URL); }
        catch (e2) {
          try { window.location.replace(CONFIG.TG_URL); }
          catch (e3) { clickAnchor("_blank"); }
        }
      }
    }

    /* Backup: if still on page after 1.2s, open new tab */
    window.setTimeout(function () {
      if (document.visibilityState === "visible" && !document.hidden) {
        clickAnchor("_blank");
      }
    }, 1200);
  }

  function tryUnlock() {
    if (redirecting) return;
    var input = document.getElementById("accessKey");
    var val = input ? String(input.value).trim() : "";

    /* CORRECT */
    if (val === CONFIG.GATE) {
      if (input) input.value = "";
      try {
        var sfx = els.sfx;
        if (sfx) {
          sfx.volume = 0.2;
          sfx.play().then(function () {
            sfx.pause(); sfx.currentTime = 0; sfx.volume = 1;
          }).catch(function () {});
        }
      } catch (e) {}
      boot();
      return;
    }

    /* WRONG / EMPTY → Telegram */
    openTelegram();
  }

  function bindGate() {
    var btn = document.getElementById("btnUnlock");
    if (btn && !btn.dataset.bound) {
      btn.dataset.bound = "1";
      btn.addEventListener("click", tryUnlock, { passive: false });
    }
    var inp = document.getElementById("accessKey");
    if (inp && !inp.dataset.bound) {
      inp.dataset.bound = "1";
      inp.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.keyCode === 13) {
          e.preventDefault();
          tryUnlock();
        }
      });
    }
  }

  document.addEventListener("DOMContentLoaded", function () { cacheDom(); bindGate(); });
  if (document.readyState === "interactive" || document.readyState === "complete") {
    cacheDom(); bindGate();
  }

})();
</script>
</body>
