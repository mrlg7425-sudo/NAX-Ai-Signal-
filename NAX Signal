/* ═══════════════════════════════════════════════════════════════
   NAX PRO ENGINE V12.5 — FINAL PRODUCTION STYLESHEET
   Author: NAX NAZMUL PRO
   ═══════════════════════════════════════════════════════════════ */
:root{
  --nv:#bc13fe; --nm:#ff2bd6; --nc:#00d2ff; --ng:#00ff88;
  --nr:#ff003c; --ny:#ffcc00;
  --glass-bg: radial-gradient(130% 90% at 50% 0%, rgba(62,20,98,.55), rgba(6,5,14,.96) 62%);
  --safe-t: env(safe-area-inset-top, 0px);
  --safe-b: env(safe-area-inset-bottom, 0px);
  --safe-l: env(safe-area-inset-left, 0px);
  --safe-r: env(safe-area-inset-right, 0px);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{height:100%;overscroll-behavior:none;}
body{
  background:#000;color:#fff;overflow:hidden;
  font-family:'Rajdhani',sans-serif;
  -webkit-font-smoothing:antialiased;text-rendering:optimizeSpeed;
  -webkit-user-select:none;user-select:none;
  -webkit-touch-callout:none;
}
input{ -webkit-user-select:text; user-select:text; }

/* ── MARKET IFRAME ── */
.market-frame{position:fixed;inset:0;width:100%;height:100%;border:none;z-index:1;}

/* ── NETWORK STATUS BANNER ── */
#netBar{
  position:fixed;top:0;left:0;right:0;z-index:15000;
  padding:6px 12px;padding-top:calc(6px + var(--safe-t));
  text-align:center;
  font-family:'Orbitron';font-size:9px;font-weight:700;letter-spacing:1.5px;
  background:linear-gradient(90deg,#ff003c,#b3002b);
  color:#fff;box-shadow:0 4px 20px rgba(255,0,60,.5);
  transform:translateY(-100%);
  transition:transform .3s cubic-bezier(.2,.9,.3,1.2);
  pointer-events:none;
}
#netBar.show{transform:translateY(0);}
#netBar.ok{background:linear-gradient(90deg,#00c060,#00ff88);color:#001a08;box-shadow:0 4px 20px rgba(0,255,136,.5);}

/* ── TOASTS ── */
#toastHost{
  position:fixed;left:50%;bottom:calc(16px + var(--safe-b));
  transform:translateX(-50%);
  z-index:16000;display:flex;flex-direction:column-reverse;gap:6px;
  pointer-events:none;max-width:90vw;
}
.toast{
  padding:9px 14px;border-radius:11px;
  font-family:'Orbitron';font-size:9.5px;font-weight:700;letter-spacing:.7px;
  color:#fff;background:rgba(10,6,20,.96);
  border:1px solid rgba(188,19,254,.5);
  box-shadow:0 8px 28px rgba(0,0,0,.85),0 0 20px rgba(188,19,254,.35);
  white-space:nowrap;max-width:90vw;
  overflow:hidden;text-overflow:ellipsis;
  animation:toastIn .28s cubic-bezier(.2,.9,.3,1.3);
  backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
}
.toast.out{animation:toastOut .22s ease forwards;}
.toast.ok{border-color:rgba(0,255,136,.6);color:#c6ffdd;box-shadow:0 8px 28px rgba(0,0,0,.85),0 0 22px rgba(0,255,136,.4);}
.toast.err{border-color:rgba(255,0,60,.6);color:#ffc6d2;box-shadow:0 8px 28px rgba(0,0,0,.85),0 0 22px rgba(255,0,60,.4);}
@keyframes toastIn{from{opacity:0;transform:translateY(14px) scale(.94)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes toastOut{to{opacity:0;transform:translateY(8px) scale(.96)}}

/* ══════════════ LOCK SCREEN ══════════════ */
#lockScreen{
  position:fixed;inset:0;z-index:10000;display:flex;align-items:center;justify-content:center;
  background:#000;padding:20px;
  padding-top:calc(20px + var(--safe-t));
  padding-bottom:calc(20px + var(--safe-b));
}
.lock-card{
  position:relative;width:min(286px,92vw);padding:26px 22px 22px;text-align:center;
  border-radius:22px;
  background:linear-gradient(150deg,rgba(36,12,58,.98),rgba(7,5,16,.99));
  border:1.4px solid rgba(188,19,254,.55);
  box-shadow:0 0 44px rgba(188,19,254,.35),0 24px 60px rgba(0,0,0,.85);
  transition:border-color .15s, box-shadow .15s;
}
.lock-card.redirecting{border-color:var(--nc);box-shadow:0 0 48px rgba(0,210,255,.7),0 24px 60px rgba(0,0,0,.85);}
.lock-mark{width:54px;height:54px;margin:0 auto 10px;display:block;filter:drop-shadow(0 0 12px rgba(188,19,254,.9));}
.lock-title{font-family:'Orbitron';font-size:21px;font-weight:900;letter-spacing:3px;color:#fff;text-shadow:0 0 20px var(--nc);}
.lock-title b{color:var(--ny);text-shadow:0 0 18px var(--ny);}
.lock-sub{font-family:'Orbitron';font-size:7px;letter-spacing:2.2px;color:var(--ny);margin:6px 0 16px;text-shadow:0 0 9px rgba(255,204,0,.8);}
.lock-input{
  width:100%;padding:13px;margin-bottom:10px;border-radius:10px;
  background:rgba(0,0,0,.72);border:1px solid rgba(188,19,254,.45);
  color:#fff;text-align:center;outline:none;
  font-family:'Orbitron';font-size:13px;letter-spacing:3px;
  transition:border-color .15s,box-shadow .15s;
}
.lock-input:focus{border-color:var(--nc);box-shadow:0 0 20px rgba(0,210,255,.4);}
.lock-input.err{border-color:var(--nr)!important;box-shadow:0 0 22px rgba(255,0,60,.55)!important;animation:shake .35s ease;}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-6px)}50%{transform:translateX(6px)}75%{transform:translateX(-4px)}}
.lock-btn{
  width:100%;min-height:46px;border:none;border-radius:10px;cursor:pointer;
  color:#fff;font-family:'Orbitron';font-size:11.5px;font-weight:700;letter-spacing:2px;
  background:linear-gradient(135deg,var(--nv),#7b2ff7 55%,var(--nc));
  box-shadow:0 0 22px rgba(188,19,254,.55);
  transition:transform .12s, background .15s, box-shadow .15s;
}
.lock-btn:active{transform:scale(.97);}
.lock-btn.redirecting{background:linear-gradient(135deg,#0088cc,var(--nc));box-shadow:0 0 30px rgba(0,210,255,.85);}
.lock-note{font-family:'Orbitron';font-size:6px;letter-spacing:1.2px;color:rgba(255,255,255,.28);margin-top:10px;}
.lock-hint{
  font-family:'Orbitron';font-size:8px;letter-spacing:1.3px;
  color:var(--nc);margin-top:10px;min-height:14px;
  opacity:0;transition:opacity .15s;text-shadow:0 0 8px rgba(0,210,255,.6);
}
.lock-hint.show{opacity:1;}
.lock-hint.err{color:var(--nr);text-shadow:0 0 8px rgba(255,0,60,.6);}
.manual-tg{
  display:none;margin-top:12px;padding:11px 14px;border-radius:10px;
  background:linear-gradient(135deg,#0088cc,#00d2ff);
  color:#fff;text-decoration:none;
  font-family:'Orbitron';font-size:10px;font-weight:700;letter-spacing:1.2px;
  box-shadow:0 0 22px rgba(0,210,255,.6);
  transition:transform .15s;
}
.manual-tg.show{display:block;animation:popIn .3s ease;}
.manual-tg:active{transform:scale(.97);}
@keyframes popIn{from{transform:scale(.9);opacity:0}to{transform:scale(1);opacity:1}}

/* ══════════════ FLOATING WINDOW ══════════════ */
#naxWindow{
  position:fixed;left:0;top:0;z-index:9000;display:none;
  will-change:transform;transform:translate3d(0,0,0);
  touch-action:none;contain:layout style;
}
.win-glow{
  padding:1.2px;border-radius:18px;
  background:linear-gradient(135deg,var(--nv),var(--nc) 26%,var(--nm) 55%,var(--nv) 100%);
  box-shadow:0 18px 44px rgba(0,0,0,.85),0 0 24px rgba(188,19,254,.26);
  transform:scale(.9);opacity:0;
  transition:transform .22s cubic-bezier(.2,.9,.3,1.2),opacity .16s linear;
}
#naxWindow.show .win-glow{transform:scale(1);opacity:1;}
#naxWindow.no-anim .win-glow{transition:none;}
#naxWindow.no-anim,#naxWindow.no-anim *{animation:none!important;}

#naxWindow.size-small {font-size:10.5px;}
#naxWindow.size-small .win-glow{width:min(170px,calc(100vw - 22px));}
#naxWindow.size-medium{font-size:11.8px;}
#naxWindow.size-medium .win-glow{width:min(208px,calc(100vw - 22px));}
#naxWindow.size-large {font-size:13.2px;}
#naxWindow.size-large .win-glow{width:min(254px,calc(100vw - 22px));}

.win-inner{
  position:relative;border-radius:17px;overflow-y:auto;overflow-x:hidden;
  max-height:calc(100vh - 22px);max-height:calc(100dvh - 22px);
  overscroll-behavior:contain;background:var(--glass-bg);
  -webkit-overflow-scrolling:touch;
}
.win-inner::-webkit-scrollbar{width:2.5px;}
.win-inner::-webkit-scrollbar-thumb{background:rgba(188,19,254,.55);border-radius:3px;}
.win-inner::after{
  content:'NAX';position:absolute;right:-.15em;bottom:-.42em;
  font-family:'Orbitron';font-size:4em;font-weight:900;letter-spacing:-.05em;
  color:rgba(188,19,254,.055);pointer-events:none;z-index:0;
}

/* ── CREATOR TELEGRAM BADGE ── */
.creator-tg{
  position:absolute;top:100%;right:0;margin-top:6px;
  display:flex;align-items:center;gap:5px;
  padding:5px 11px 5px 7px;min-height:26px;border-radius:14px;
  background:linear-gradient(135deg,#0088cc,#00d2ff);color:#fff;
  font-family:'Orbitron';font-size:8px;font-weight:700;letter-spacing:.5px;
  text-decoration:none;border:1px solid rgba(255,255,255,.35);
  box-shadow:0 4px 14px rgba(0,0,0,.6),0 0 16px rgba(0,210,255,.55);
  z-index:8;white-space:nowrap;
  touch-action:manipulation;pointer-events:auto;cursor:pointer;
  transition:transform .15s, box-shadow .15s;
  -webkit-user-select:none;user-select:none;
}
.creator-tg:hover{transform:translateY(-1px);box-shadow:0 6px 20px rgba(0,0,0,.7),0 0 24px rgba(0,210,255,.85);}
.creator-tg:active{transform:translateY(0) scale(.96);}
.creator-tg svg{width:12px;height:12px;flex:0 0 auto;filter:drop-shadow(0 0 3px rgba(255,255,255,.6));pointer-events:none;}
.creator-tg .name{pointer-events:none;}
.creator-tg .handle{pointer-events:none;color:rgba(255,255,255,.75);font-size:7px;letter-spacing:.3px;margin-left:2px;}

/* ── HEADER ── */
.win-hd{
  position:relative;z-index:4;
  display:flex;align-items:center;justify-content:space-between;gap:.4em;
  padding:.5em .55em .42em;border-bottom:1px solid rgba(255,255,255,.06);
  cursor:grab;touch-action:none;
}
.win-hd:active{cursor:grabbing;}
.hd-brand{display:flex;align-items:center;gap:.4em;min-width:0;flex:1;pointer-events:none;}
.hd-logo{width:1.5em;height:1.5em;flex:0 0 auto;filter:drop-shadow(0 0 .35em rgba(188,19,254,.85));}
.hd-txt{min-width:0;}
.hd-name{
  font-family:'Orbitron';font-size:.68em;font-weight:900;letter-spacing:.04em;
  line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  color:#fff;text-shadow:0 0 .7em rgba(0,210,255,.5);
}
.hd-name b{color:var(--ny);text-shadow:0 0 .7em rgba(255,204,0,.75);}
.hd-meta{
  display:flex;align-items:center;gap:.3em;margin-top:.1em;
  font-family:'Orbitron';font-size:.46em;letter-spacing:.08em;
  color:rgba(255,255,255,.48);white-space:nowrap;
}
.sdot{width:.5em;height:.5em;border-radius:50%;background:var(--ng);
  box-shadow:0 0 .35em var(--ng);animation:blink 1.8s infinite;flex:0 0 auto;}
.sdot.warn{background:var(--ny);box-shadow:0 0 .35em var(--ny);animation:none;}
.sdot.err{background:var(--nr);box-shadow:0 0 .35em var(--nr);animation:none;}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
.sep{opacity:.4;}

.hd-btns{display:flex;gap:.26em;flex:0 0 auto;}
.ico-btn{
  width:1.85em;height:1.85em;min-width:28px;min-height:28px;
  display:grid;place-items:center;border-radius:.5em;cursor:pointer;
  background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);
  color:rgba(255,255,255,.78);
  transition:background .15s,border-color .15s,color .15s,transform .12s;
  padding:0;
}
.ico-btn svg{width:1em;height:1em;display:block;pointer-events:none;stroke-linecap:round;stroke-linejoin:round;}
.ico-btn:hover{background:rgba(188,19,254,.24);border-color:rgba(188,19,254,.6);color:#fff;}
.ico-btn:active{transform:scale(.9);}
.ico-btn.on{color:var(--ny);background:rgba(255,204,0,.14);border-color:rgba(255,204,0,.55);}
.ico-btn.danger:hover{background:rgba(255,0,60,.28);border-color:rgba(255,0,60,.7);color:#fff;}

/* ── BODY ── */
.win-body{position:relative;z-index:2;padding:.45em .55em .55em;}
.core{
  position:relative;overflow:hidden;display:flex;align-items:center;gap:.5em;
  padding:.42em .45em;border-radius:.72em;
  background:linear-gradient(180deg,rgba(188,19,254,.13),rgba(0,0,0,.52));
  border:1px solid rgba(188,19,254,.26);
}
.ring-wrap{position:relative;width:2.9em;height:2.9em;flex:0 0 auto;}
.ring{width:100%;height:100%;transform:rotate(-90deg);}
.ring-bg{fill:none;stroke:rgba(255,255,255,.09);stroke-width:4.5;}
.ring-fg{fill:none;stroke:var(--nc);stroke-width:4.5;stroke-linecap:round;
  filter:drop-shadow(0 0 .18em var(--nc));transition:stroke-dashoffset .3s linear;will-change:stroke-dashoffset;}
.ring-txt{
  position:absolute;inset:0;display:grid;place-items:center;
  font-family:'Orbitron';font-size:.78em;font-weight:900;color:var(--nc);
  text-shadow:0 0 .6em rgba(0,210,255,.9);
}
.sig{flex:1;min-width:0;text-align:center;cursor:pointer;position:relative;}
.sig:active{transform:scale(.98);}
.sig-label{font-family:'Orbitron';font-size:.44em;letter-spacing:.2em;color:rgba(255,255,255,.42);margin-bottom:.18em;}
.sig-val{font-family:'Orbitron';font-size:1.85em;font-weight:900;line-height:1;letter-spacing:.02em;transition:color .2s;}
.sig-val.BIG{color:var(--nc);text-shadow:0 0 .4em rgba(0,210,255,.75);}
.sig-val.SMALL{color:var(--nr);text-shadow:0 0 .4em rgba(255,0,60,.75);}
.sig-val.idle{color:rgba(255,255,255,.22);text-shadow:none;font-size:1.3em;}
.sig-sub{
  margin-top:.22em;min-height:1em;text-transform:uppercase;
  font-family:'Orbitron';font-size:.46em;letter-spacing:.12em;
  color:var(--ny);text-shadow:0 0 .5em rgba(255,204,0,.55);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}

/* ── ST ROW ── */
.st-row{display:grid;grid-template-columns:repeat(4,1fr);gap:.24em;margin-top:.4em;}
.st-btn{
  min-height:34px;border-radius:.5em;cursor:pointer;
  display:grid;place-items:center;
  transition:background .15s,border-color .15s,color .15s;
  background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.09);
  color:rgba(255,255,255,.5);
  font-family:'Orbitron';font-size:.52em;font-weight:700;letter-spacing:.04em;
}
.st-btn:hover{background:rgba(188,19,254,.15);border-color:rgba(188,19,254,.5);color:#fff;}
.st-btn:active{transform:scale(.96);}
.st-btn.active{
  color:#fff;border-color:rgba(255,255,255,.4);
  background:linear-gradient(135deg,var(--nv),#7b2ff7);
  box-shadow:0 0 .85em rgba(188,19,254,.8),inset 0 0 .5em rgba(255,255,255,.16);
  text-shadow:0 0 .4em rgba(255,255,255,.9);
}

/* ── STATS ── */
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:.26em;margin-top:.36em;}
.stat{
  position:relative;overflow:hidden;padding:.3em .15em;border-radius:.5em;
  text-align:center;background:rgba(255,255,255,.035);
  border:1px solid rgba(255,255,255,.07);cursor:pointer;
  transition:background .15s,border-color .15s;
}
.stat:hover{background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.14);}
.stat:active{transform:scale(.97);}
.stat .k{font-family:'Orbitron';font-size:.46em;letter-spacing:.1em;color:rgba(255,255,255,.45);}
.stat .v{font-family:'Orbitron';font-size:.78em;font-weight:900;margin-top:.05em;}
.stat::after{content:'';position:absolute;left:0;bottom:0;width:100%;height:2px;opacity:.85;}
.stat.w::after{background:linear-gradient(90deg,transparent,var(--ng),transparent);}
.stat.l::after{background:linear-gradient(90deg,transparent,var(--nr),transparent);}
.stat.a::after{background:linear-gradient(90deg,transparent,var(--nc),transparent);}
.v.w{color:var(--ng);text-shadow:0 0 .5em rgba(0,255,136,.6);}
.v.l{color:var(--nr);text-shadow:0 0 .5em rgba(255,0,60,.6);}
.v.a{color:var(--nc);text-shadow:0 0 .5em rgba(0,210,255,.6);}

/* ── LOGS ── */
.logs{
  margin-top:.36em;max-height:4.6em;overflow-y:auto;overscroll-behavior:contain;
  border-radius:.5em;background:rgba(0,0,0,.5);
  border:1px solid rgba(255,255,255,.06);padding:.08em .4em;
  -webkit-overflow-scrolling:touch;
}
.logs::-webkit-scrollbar{width:2.5px;}
.logs::-webkit-scrollbar-thumb{background:rgba(188,19,254,.5);border-radius:3px;}
.log-row{
  display:flex;align-items:center;justify-content:space-between;gap:.3em;
  padding:.26em 0;border-bottom:1px dashed rgba(255,255,255,.055);
  font-family:'Orbitron';font-size:.5em;letter-spacing:.03em;
}
.log-row:last-child{border-bottom:none;}
.log-id{color:rgba(255,255,255,.34);}
.log-res{font-weight:900;}
.log-res.BIG{color:var(--nc);}
.log-res.SMALL{color:var(--nr);}
.log-tag{
  font-size:.85em;padding:.08em .32em;border-radius:3px;
  color:var(--nc);background:rgba(0,210,255,.1);
  border:1px solid rgba(0,210,255,.24);
}
.logs-empty{
  padding:.55em 0;text-align:center;font-family:'Orbitron';font-size:.48em;
  letter-spacing:.1em;color:rgba(255,255,255,.25);
}

/* ── ACTIONS ── */
.actions{display:grid;grid-template-columns:1fr 1fr;gap:.3em;margin-top:.4em;}
.act{
  min-height:38px;border-radius:.55em;cursor:pointer;text-decoration:none;
  display:flex;align-items:center;justify-content:center;gap:.32em;
  font-family:'Orbitron';font-size:.52em;font-weight:700;letter-spacing:.04em;
  border:1px solid transparent;transition:background .15s,box-shadow .15s;
  padding:0 .35em;
}
.act svg{width:1.05em;height:1.05em;flex:0 0 auto;pointer-events:none;stroke-linecap:round;stroke-linejoin:round;}
.act:active{transform:scale(.96);}
.act.audio{background:rgba(188,19,254,.12);border-color:rgba(188,19,254,.45);color:#e6c9ff;}
